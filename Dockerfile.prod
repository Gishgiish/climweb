# syntax = docker/dockerfile:1.5

FROM ghcr.io/osgeo/gdal:ubuntu-full-3.7.0 as base
ARG UID
ENV UID=${UID:-1001}
ARG GID
ENV GID=${GID:-1001}
ARG POSTGRES_VERSION=15
ENV POSTGRES_VERSION=${POSTGRES_VERSION}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Create user/group in one layer
RUN if getent group $GID > /dev/null; then \
        existing_group=$(getent group $GID | cut -d: -f1); \
        if [ "$existing_group" != "climweb_docker_group" ]; then \
            groupmod -n climweb_docker_group "$existing_group"; \
        fi; \
    else \
        groupadd -g $GID climweb_docker_group; \
    fi && \
    useradd --shell /bin/bash -u $UID -g $GID -o -c "" -m climweb_docker_user -l || true

ENV DOCKER_USER=climweb_docker_user

# Install packages - include runtime tools, GEOS/GDAL runtime deps and postgres client
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        lsb-release \
        ca-certificates \
        gnupg2 \
        curl \
        cron \
        tini \
        gosu \
        gdal-bin \
        inotify-tools \
        libffi-dev \
        libpq-dev \
        libgdal-dev \
        libgeos-dev \
        imagemagick \
        libmagic1 \
        libcairo2-dev \
        libpangocairo-1.0-0 \
        python3-pip \
        python3-dev \
        python3-venv \
        poppler-utils \
        git \
    && echo "deb http://apt.postgresql.org/pub/repos/apt/ $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && curl --silent https://www.postgresql.org/media/keys/ACCC4CF8.asc | apt-key add - \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-${POSTGRES_VERSION} \
    && apt-get autoclean && apt-get clean && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && pip install GDAL==$(gdal-config --version)

# Install docker-compose wait
ARG DOCKER_COMPOSE_WAIT_VERSION=2.12.1
ADD https://github.com/ufoscout/docker-compose-wait/releases/download/${DOCKER_COMPOSE_WAIT_VERSION}/wait /wait
RUN chmod +x /wait

ENV WAIT_TIMEOUT=120
ENV WAIT_SLEEP=2

# Production runtime defaults: keep verify_db off by default to avoid
# extra DB connections during startup; set conservative Gunicorn defaults
# that limit concurrent DB connections per container.
ENV VERIFY_DB_ON_STARTUP=false
ENV GUNICORN_NUM_OF_WORKERS=2
ENV GUNICORN_THREADS=4
ENV GUNICORN_MAX_REQUESTS=1000

# Create directories and set permissions BEFORE switching user
RUN mkdir -p /climweb/web /climweb/plugins /climweb/tmp /root/.cache/pip && \
    chown -R $UID:$GID /climweb /root/.cache/pip

# Enable pip caching dir (do not enable buildkit mounts here)
ENV PIP_CACHE_DIR=/root/.cache/pip
ENV PIP_NO_CACHE_DIR=0

# Ensure venv is picked up by subsequent RUNs
ENV PATH="/climweb/venv/bin:$PATH"

# NOW switch to non-root user
USER $UID:$GID

# Copy requirements and install Python dependencies into the venv
COPY --chown=$UID:$GID ./climweb/requirements/base.txt /climweb/requirements/
RUN python3 -m venv /climweb/venv && \
    /climweb/venv/bin/pip install --no-cache-dir -r /climweb/requirements/base.txt && \
    /climweb/venv/bin/pip install --no-cache-dir GDAL==$(gdal-config --version)

# Copy application code
COPY --chown=$UID:$GID ./climweb /climweb/climweb
COPY --chown=$UID:$GID ./web /climweb/web

# Create runtime directories
RUN mkdir -p /climweb/web/src/climweb/static \
    /climweb/web/src/climweb/media \
    /climweb/web/src/climweb/backup \
    /climweb/geomanager/data && \
    chown -R $UID:$GID /climweb/web/src/climweb /climweb/geomanager/data

WORKDIR /climweb/web

ENV PYTHONUNBUFFERED=1
ENV GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
ENV GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so.1
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

# Copy deploy plugins
COPY --chown=$UID:$GID ./deploy/plugins/*.sh /climweb/plugins/

ENV GEOMANAGER_AUTO_INGEST_RASTER_DATA_DIR=/climweb/geomanager/data

# Install climweb package
RUN chmod a+x /climweb/climweb/docker/docker-entrypoint.sh && \
    /climweb/venv/bin/pip install --no-cache-dir -e /climweb/climweb/

# Pre-generate matplotlib font cache (fontlist-v330.json) if matplotlib is available.
# This reduces runtime first-start delays and avoids font-cache warnings.
RUN /climweb/venv/bin/python - <<'PY' || true
import importlib, sys
spec = importlib.util.find_spec('matplotlib')
if spec:
    try:
        from matplotlib import font_manager
        font_manager._rebuild()
        print('matplotlib fontlist rebuilt')
    except Exception as e:
        print('failed to rebuild matplotlib fontlist:', e, file=sys.stderr)
else:
    print('matplotlib not installed; skipping fontlist rebuild')
PY


# Development stage (non-final). Placed before the final production stage
# so the `base` stage remains the default final image when no --target is
# specified. This allows local builds without `--target=base` to produce the
# production-ready image by default.
FROM base as dev
USER $UID:$GID
ENV DJANGO_SETTINGS_MODULE='climweb.config.settings.dev'
CMD ["django-dev-no-attach"]

ENTRYPOINT ["/usr/bin/tini", "--", "/bin/bash", "/climweb/climweb/docker/docker-entrypoint.sh"]

# Ensure venv is first on PATH at container runtime
ENV PATH="/climweb/venv/bin:$PATH"
# Standardized production settings module name
ENV DJANGO_SETTINGS_MODULE='climweb.config.settings.production'

# Use lightweight HTTP health endpoint for container healthchecks to avoid
# performing heavy DB/PostGIS checks which can exhaust DB connections.
HEALTHCHECK --interval=1m --timeout=10s --start-period=30s --retries=3 \
    CMD /usr/bin/curl -fsS http://127.0.0.1:8000/api/_health/ >/dev/null 2>&1 || exit 1

CMD ["gunicorn"]